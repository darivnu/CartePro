  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session_token",
        "description": "Session token set by `POST /auth/login` (or registration endpoints). Click Authorize and paste the token value, or simply call the login endpoint first and Swagger UI will include the cookie automatically."
      }
    },
    "schemas": {
      "TransactionResponse": {
        "type": "object",
        "properties": {
          "ID": {
            "type": "integer",
            "example": 1
          },
          "Amount": {
            "type": "integer",
            "example": 850,
            "description": "Amount in euro-cents (\u20ac8.50)"
          },
          "ReceiverName": {
            "type": "string",
            "example": "Le Bistrot Parisien"
          },
          "ReceiverUserID": {
            "type": "integer",
            "example": 3
          },
          "SenderName": {
            "type": "string",
            "example": "Jean Dupont"
          },
          "SenderUserID": {
            "type": "integer",
            "example": 2
          },
          "CreatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "Cancelled": {
            "type": "boolean",
            "example": false
          },
          "Type": {
            "type": "string",
            "example": "debit",
            "enum": [
              "debit",
              "topup",
              "reversal"
            ]
          },
          "Comment": {
            "type": "string",
            "example": "September allowance"
          },
          "OriginalTransactionID": {
            "type": "integer",
            "nullable": true,
            "example": null
          }
        }
      }
    }
  }
}