DB_HOST=db
DB_USER=gorm
DB_PASSWORD=gorm
DB_NAME=gorm
DB_PORT=5432
# DB_SSLMODE=disable is right for local/docker-compose postgres.
# Set to "require" on Vercel against a managed Postgres (Neon, Supabase, Vercel Postgres, ...).
DB_SSLMODE=disable
BACKEND_PORT=4242
FRONTEND_ORIGIN=http://localhost:3000
# COOKIE_SECURE=false is right for local http. Set to "true" once the API is served over HTTPS (e.g. on Vercel).
COOKIE_SECURE=false
QR_SIGNING_SECRET=supa_secret_key
HRIS_API_KEY=your_hris_api_key
